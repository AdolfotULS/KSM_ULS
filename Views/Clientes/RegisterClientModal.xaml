<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="KSM_ULS.Views.RegisterClientModal"
             BackgroundColor="Transparent">

       <Grid>
              <BoxView BackgroundColor="#80000000">
                     <BoxView.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnOverlayTapped"/>
                     </BoxView.GestureRecognizers>
              </BoxView>

              <Border HorizontalOptions="Center"
                      VerticalOptions="Center"
                      BackgroundColor="White"
                      StrokeThickness="0"
                      Stroke="Transparent"
                      Padding="0"
                      MaximumWidthRequest="600"
                      WidthRequest="600"
                      HeightRequest="750">
                     <Border.StrokeShape>
                            <RoundRectangle CornerRadius="16"/>
                     </Border.StrokeShape>
                     <Border.Shadow>
                            <Shadow Brush="Black"
                                    Opacity="0.3"
                                    Radius="20"
                                    Offset="0,5"/>
                     </Border.Shadow>

                     <Grid RowDefinitions="Auto,Auto,*,Auto"
                           Padding="24"
                           RowSpacing="20">

                            <Grid Grid.Row="0"
                                  ColumnDefinitions="*,Auto">
                                   <VerticalStackLayout Grid.Column="0"
                                                        Spacing="5">
                                          <Label x:Name="TitleLabel"
                                                 Text="Registrar Nuevo Cliente"
                                                 FontSize="20"
                                                 FontAttributes="Bold"
                                                 TextColor="#333333"/>
                                          <Label Text="Registra un nuevo cliente en el sistema"
                                                 FontSize="13"
                                                 TextColor="#0066FF"/>
                                   </VerticalStackLayout>

                                   <Button Grid.Column="1"
                                           Text="✕"
                                           FontSize="20"
                                           WidthRequest="30"
                                           HeightRequest="30"
                                           BackgroundColor="Transparent"
                                           TextColor="#666666"
                                           Padding="0"
                                           Clicked="OnCloseClicked"
                                           VerticalOptions="Start"/>
                            </Grid>

                            <HorizontalStackLayout Grid.Row="1"
                                                   Spacing="0">
                                   <Grid>
                                          <Button x:Name="EmpresaTab"
                                                  Text="Empresa"
                                                  BackgroundColor="Transparent"
                                                  TextColor="#0066FF"
                                                  CornerRadius="0"
                                                  Padding="20,10"
                                                  BorderWidth="0"
                                                  Clicked="OnEmpresaTabClicked"/>
                                          <BoxView x:Name="EmpresaUnderline"
                                                   HeightRequest="2"
                                                   BackgroundColor="#0066FF"
                                                   VerticalOptions="End"
                                                   IsVisible="True"/>
                                   </Grid>

                                   <Grid>
                                          <Button x:Name="PersonaTab"
                                                  Text="Persona"
                                                  BackgroundColor="Transparent"
                                                  TextColor="#666666"
                                                  CornerRadius="0"
                                                  Padding="20,10"
                                                  BorderWidth="0"
                                                  Clicked="OnPersonaTabClicked"/>
                                          <BoxView x:Name="PersonaUnderline"
                                                   HeightRequest="2"
                                                   BackgroundColor="Transparent"
                                                   VerticalOptions="End"
                                                   IsVisible="False"/>
                                   </Grid>
                            </HorizontalStackLayout>

                            <ScrollView Grid.Row="2">
                                   <VerticalStackLayout Spacing="20">

                                          <Grid x:Name="EmpresaForm"
                                                ColumnDefinitions="*,*"
                                                RowDefinitions="Auto,Auto,Auto"
                                                ColumnSpacing="20"
                                                RowSpacing="25"
                                                IsVisible="True">

                                                 <VerticalStackLayout Grid.Column="0"
                                                                      Grid.Row="0"
                                                                      Spacing="8">
                                                        <Label Text="Nombre de la empresa"
                                                               FontSize="13"
                                                               TextColor="#333333"/>
                                                        <Entry x:Name="EmpresaNameEntry"
                                                               Placeholder="Ej: ABC Tecnología S.A."
                                                               BackgroundColor="#F5F5F5"
                                                               TextColor="#333333"
                                                               HeightRequest="45"/>
                                                 </VerticalStackLayout>

                                                 <VerticalStackLayout Grid.Column="0"
                                                                      Grid.Row="1"
                                                                      Spacing="8">
                                                        <Label Text="Email corporativo"
                                                               FontSize="13"
                                                               TextColor="#333333"/>
                                                        <Entry x:Name="EmpresaEmailEntry"
                                                               Placeholder="contacto@empresa.com"
                                                               Keyboard="Email"
                                                               BackgroundColor="#F5F5F5"
                                                               TextColor="#333333"
                                                               HeightRequest="45"/>
                                                 </VerticalStackLayout>

                                                 <VerticalStackLayout Grid.Column="0"
                                                                      Grid.Row="2"
                                                                      Spacing="8">
                                                        <Label Text="Dirección"
                                                               FontSize="13"
                                                               TextColor="#333333"/>
                                                        <Entry x:Name="EmpresaAddressEntry"
                                                               Placeholder="Av. Principal 123, Ciudad"
                                                               BackgroundColor="#F5F5F5"
                                                               TextColor="#333333"
                                                               HeightRequest="45"/>
                                                 </VerticalStackLayout>

                                                 <VerticalStackLayout Grid.Column="1"
                                                                      Grid.Row="0"
                                                                      Spacing="8">
                                                        <Label Text="Persona de contacto"
                                                               FontSize="13"
                                                               TextColor="#333333"/>
                                                        <Entry x:Name="EmpresaContactEntry"
                                                               Placeholder="Ej: Juan Pérez"
                                                               BackgroundColor="#F5F5F5"
                                                               TextColor="#333333"
                                                               HeightRequest="45"/>
                                                 </VerticalStackLayout>

                                                 <VerticalStackLayout Grid.Column="1"
                                                                      Grid.Row="1"
                                                                      Spacing="8">
                                                        <Label Text="Teléfono"
                                                               FontSize="13"
                                                               TextColor="#333333"/>
                                                        <Entry x:Name="EmpresaPhoneEntry"
                                                               Placeholder="+1 555-0123"
                                                               Keyboard="Telephone"
                                                               BackgroundColor="#F5F5F5"
                                                               TextColor="#333333"
                                                               HeightRequest="45"/>
                                                 </VerticalStackLayout>
                                          </Grid>

                                          <Grid x:Name="PersonaForm"
                                                ColumnDefinitions="*,*"
                                                RowDefinitions="Auto,Auto,Auto"
                                                ColumnSpacing="20"
                                                RowSpacing="25"
                                                IsVisible="False">

                                                 <VerticalStackLayout Grid.Column="0"
                                                                      Grid.Row="0"
                                                                      Spacing="8">
                                                        <Label Text="Nombre completo"
                                                               FontSize="13"
                                                               TextColor="#333333"/>
                                                        <Entry x:Name="PersonaNameEntry"
                                                               Placeholder="Ej: Juan Pérez"
                                                               BackgroundColor="#F5F5F5"
                                                               TextColor="#333333"
                                                               HeightRequest="45"/>
                                                 </VerticalStackLayout>

                                                 <VerticalStackLayout Grid.Column="0"
                                                                      Grid.Row="1"
                                                                      Spacing="8">
                                                        <Label Text="Email personal"
                                                               FontSize="13"
                                                               TextColor="#333333"/>
                                                        <Entry x:Name="PersonaEmailEntry"
                                                               Placeholder="ejemplo@email.com"
                                                               Keyboard="Email"
                                                               BackgroundColor="#F5F5F5"
                                                               TextColor="#333333"
                                                               HeightRequest="45"/>
                                                 </VerticalStackLayout>

                                                 <VerticalStackLayout Grid.Column="0"
                                                                      Grid.Row="2"
                                                                      Spacing="8">
                                                        <Label Text="Dirección"
                                                               FontSize="13"
                                                               TextColor="#333333"/>
                                                        <Entry x:Name="PersonaAddressEntry"
                                                               Placeholder="Calle 45 #789, Ciudad"
                                                               BackgroundColor="#F5F5F5"
                                                               TextColor="#333333"
                                                               HeightRequest="45"/>
                                                 </VerticalStackLayout>

                                                 <VerticalStackLayout Grid.Column="1"
                                                                      Grid.Row="0"
                                                                      Spacing="8">
                                                        <Label Text="Teléfono"
                                                               FontSize="13"
                                                               TextColor="#333333"/>
                                                        <Entry x:Name="PersonaPhoneEntry"
                                                               Placeholder="+1 555-0123"
                                                               Keyboard="Telephone"
                                                               BackgroundColor="#F5F5F5"
                                                               TextColor="#333333"
                                                               HeightRequest="45"/>
                                                 </VerticalStackLayout>
                                          </Grid>

                                          <VerticalStackLayout Spacing="8"
                                                               Margin="0,10,0,0">
                                                 <Label Text="Preferencia de notificación"
                                                        FontSize="13"
                                                        TextColor="#333333"/>
                                                 <Picker x:Name="NotificationPicker"
                                                         Title="Seleccionar método"
                                                         BackgroundColor="#F5F5F5"
                                                         TextColor="#333333"
                                                         HeightRequest="45">
                                                        <Picker.Items>
                                                               <x:String>Email</x:String>
                                                               <x:String>SMS</x:String>
                                                               <x:String>Teléfono</x:String>
                                                        </Picker.Items>
                                                 </Picker>
                                          </VerticalStackLayout>

                                   </VerticalStackLayout>
                            </ScrollView>

                            <Grid Grid.Row="3"
                                  ColumnDefinitions="*,*"
                                  ColumnSpacing="15"
                                  Margin="0,10,0,0">
                                   <Button Grid.Column="0"
                                           Text="Cancelar"
                                           BackgroundColor="#E0E0E0"
                                           TextColor="#333333"
                                           CornerRadius="8"
                                           HeightRequest="45"
                                           Clicked="OnCancelClicked"/>
                                   <Button Grid.Column="1"
                                           x:Name="SaveButton"
                                           Text="Registrar Cliente"
                                           BackgroundColor="#0066FF"
                                           TextColor="White"
                                           CornerRadius="8"
                                           HeightRequest="45"
                                           Clicked="OnSaveClicked"/>
                            </Grid>

                     </Grid>
              </Border>
       </Grid>

</ContentPage>
