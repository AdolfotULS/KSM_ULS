<?xml version="1.0" encoding="utf-8" ?>
<toolkit:Popup xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="KSM_ULS.Views.Config_options.popUpConfig"    
             xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit">
    <VerticalStackLayout>
        <Label 
            Text="Welcome to .NET MAUI!"
            VerticalOptions="Center" 
            HorizontalOptions="Center" />
        <Button Text="Poton 1" Clicked="onClickButton1"></Button>
        <Button Text="Poton 2" Clicked="onClickButton2"></Button>
        <Button Text="Poton 3" Clicked="onClickButton3"></Button>
        <Button Text="Cerrar" Clicked="onClickClosePopUp"></Button>
    </VerticalStackLayout>
</toolkit:Popup>
