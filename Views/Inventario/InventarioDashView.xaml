<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="KSM_ULS.Views.Inventario.InventarioDashView"
            xmlns:local="clr-namespace:KSM_ULS.Views.Inventario">
    
    <VerticalStackLayout>
        <HorizontalStackLayout>
            <Label Text="Inventario:" VerticalOptions="Center" HorizontalOptions="Start" />
            <Button Text="Añadir producto" HorizontalOptions="End" Clicked="OnClickedAddIventory"></Button>
        </HorizontalStackLayout>
        <SearchBar x:Name="SearchbarInventoryoQuery" Placeholder="Especificaciones" TextChanged="OnChangeTextBarInventory" ></SearchBar>
            <Border>
                
                <CollectionView x:Name="InventoryList" HeightRequest="300">
                
                    <CollectionView.ItemTemplate >
                        <DataTemplate >
                        <local:InventarioCardView Padding="10"></local:InventarioCardView>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                
            </CollectionView>

            </Border>
    </VerticalStackLayout>
</ContentView>