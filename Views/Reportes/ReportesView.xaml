<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="KSM_ULS.Views.ReportesView"
             BackgroundColor="#F9FAFB">

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="18">

            <!-- Título -->
            <Label Text="Reportes y Análisis"
                   FontSize="22"
                   FontAttributes="Bold"
                   TextColor="#111827"/>

            <Label Text="Estadísticas detalladas del negocio"
                   FontSize="13"
                   TextColor="#6B7280"
                   Margin="0,0,0,10"/>

            <!-- Tarjetas de resumen responsivas -->
            <FlexLayout Direction="Row"
                        Wrap="Wrap"
                        JustifyContent="SpaceBetween"
                        AlignItems="Start"
                        Margin="0,0,0,10">

                <!-- Ingresos -->
                <Frame BorderColor="#E5E7EB"
                       CornerRadius="12"
                       Padding="14"
                       FlexLayout.Basis="48%"
                       MinimumWidthRequest="160">
                    <VerticalStackLayout>
                        <Label Text="Ingresos del Mes" FontAttributes="Bold" FontSize="13" TextColor="#111827"/>
                        <Label Text="{Binding Resumen.IngresosMes, StringFormat='${0:N0}'}"
                               FontSize="{OnIdiom Phone=22, Default=24}"
                               FontAttributes="Bold"
                               TextColor="#059669"/>
                        <Label Text="{Binding Resumen.VariacionIngresosMes, StringFormat='+{0}% vs mes anterior'}"
                               FontSize="11"
                               TextColor="#10B981"/>
                    </VerticalStackLayout>
                </Frame>

                <!-- Tickets -->
                <Frame BorderColor="#E5E7EB"
                       CornerRadius="12"
                       Padding="14"
                       FlexLayout.Basis="48%"
                       MinimumWidthRequest="160">
                    <VerticalStackLayout>
                        <Label Text="Tickets Completados" FontAttributes="Bold" FontSize="13" TextColor="#111827"/>
                        <Label Text="{Binding Resumen.TicketsCompletados}"
                               FontSize="{OnIdiom Phone=22, Default=24}"
                               FontAttributes="Bold"
                               TextColor="#2563EB"/>
                        <Label Text="{Binding Resumen.VariacionTickets, StringFormat='+{0}% vs mes anterior'}"
                               FontSize="11"
                               TextColor="#60A5FA"/>
                    </VerticalStackLayout>
                </Frame>

                <!-- Clientes -->
                <Frame BorderColor="#E5E7EB"
                       CornerRadius="12"
                       Padding="14"
                       FlexLayout.Basis="48%"
                       MinimumWidthRequest="160">
                    <VerticalStackLayout>
                        <Label Text="Clientes Nuevos" FontAttributes="Bold" FontSize="13" TextColor="#111827"/>
                        <Label Text="{Binding Resumen.ClientesNuevos}"
                               FontSize="{OnIdiom Phone=22, Default=24}"
                               FontAttributes="Bold"
                               TextColor="#7C3AED"/>
                        <Label Text="{Binding Resumen.VariacionClientes, StringFormat='+{0}% vs mes anterior'}"
                               FontSize="11"
                               TextColor="#A78BFA"/>
                    </VerticalStackLayout>
                </Frame>

                <!-- Gastos -->
                <Frame BorderColor="#E5E7EB"
                       CornerRadius="12"
                       Padding="14"
                       FlexLayout.Basis="48%"
                       MinimumWidthRequest="160">
                    <VerticalStackLayout>
                        <Label Text="Gastos del Mes" FontAttributes="Bold" FontSize="13" TextColor="#111827"/>
                        <Label Text="{Binding Resumen.GastosMes, StringFormat='${0:N0}'}"
                               FontSize="{OnIdiom Phone=22, Default=24}"
                               FontAttributes="Bold"
                               TextColor="#DC2626"/>
                        <Label Text="{Binding Resumen.VariacionGastos, StringFormat='-{0}% vs mes anterior'}"
                               FontSize="11"
                               TextColor="#F87171"/>
                    </VerticalStackLayout>
                </Frame>

            </FlexLayout>

            <!-- Submenú de vistas -->
            <ScrollView Orientation="Horizontal" Margin="0,10,0,0">
                <HorizontalStackLayout HorizontalOptions="Center" Spacing="8">
                    <Button Text="Financiero"
                            Command="{Binding CambiarVistaCommand}"
                            CommandParameter="Financiero"
                            BackgroundColor="{Binding IsFinanciero, Converter={StaticResource BoolToColorConverter}}"/>
                    <Button Text="Operaciones"
                            Command="{Binding CambiarVistaCommand}"
                            CommandParameter="Operaciones"
                            BackgroundColor="{Binding IsOperaciones, Converter={StaticResource BoolToColorConverter}}"/>
                    <Button Text="Rendimiento"
                            Command="{Binding CambiarVistaCommand}"
                            CommandParameter="Rendimiento"
                            BackgroundColor="{Binding IsRendimiento, Converter={StaticResource BoolToColorConverter}}"/>
                    <Button Text="Gastos"
                            Command="{Binding CambiarVistaCommand}"
                            CommandParameter="Gastos"
                            BackgroundColor="{Binding IsGastos, Converter={StaticResource BoolToColorConverter}}"/>
                </HorizontalStackLayout>
            </ScrollView>

            <!-- Contenedor donde se cargan las sub-vistas -->
            <ContentView x:Name="ContenidoActual" />

            <Frame BorderColor="#E5E7EB"
       CornerRadius="12"
       Padding="12"
       Margin="0,20,0,10"
       BackgroundColor="White">

                <VerticalStackLayout Spacing="12">
                    <Label Text=" Exportar Reportes"
               FontSize="14"
               FontAttributes="Bold"/>

                    <Label Text="Genera reportes detallados en diferentes formatos"
               FontSize="12"
               TextColor="#6B7280"/>

                    <!-- Lista de botones vertical -->
                    <VerticalStackLayout Spacing="8">

                        <Button Text="Datos en Excel"
                    BackgroundColor="#DCFCE7"
                    TextColor="#15803D"
                    CornerRadius="10"
                    HorizontalOptions="FillAndExpand"
                    HeightRequest="42"/>

                        <Button Text=" Reporte de Técnicos"
                    BackgroundColor="#DBEAFE"
                    TextColor="#1E40AF"
                    CornerRadius="10"
                    HorizontalOptions="FillAndExpand"
                    HeightRequest="42"/>

                        <Button Text="Reporte Financiero PDF"
                    BackgroundColor="#FEE2E2"
                    TextColor="#B91C1C"
                    CornerRadius="10"
                    HorizontalOptions="FillAndExpand"
                    HeightRequest="42"/>
                    </VerticalStackLayout>
                </VerticalStackLayout>
            </Frame>

        </VerticalStackLayout>
    </ScrollView>
</ContentView>
