<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="KSM_ULS.Views.inventarioMenu.inventarioDashView"
            xmlns:local="clr-namespace:KSM_ULS.Views.inventarioMenu">
    
    <VerticalStackLayout>
        <HorizontalStackLayout>
            <Label Text="Inventario:" VerticalOptions="Center" HorizontalOptions="Start" />
            <Button Text="Añadir producto" HorizontalOptions="End" Clicked="onClickedAddIventory"></Button>
        </HorizontalStackLayout>
        <SearchBar x:Name="searchbarInventoryoQuery" Placeholder="Especificaciones" TextChanged="onChangeTextBarInventory" ></SearchBar>
        <Border>
            <CollectionView x:Name="inventoryList">
                
                    <CollectionView.ItemTemplate >
                        <DataTemplate >
                            <local:inventarioCardView Padding="10"></local:inventarioCardView>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                
            </CollectionView>
        </Border>
    </VerticalStackLayout>
</ContentView>