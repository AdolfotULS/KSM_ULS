<?xml version="1.0" encoding="utf-8" ?>
<toolkit:Popup xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="KSM_ULS.Views.TicketView.menusPopUp.detailsTicketPupUp"
             xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit">

    <VerticalStackLayout Grid.Column="3">
        <Label x:Name="clientNameLabel" Text="{Binding clientName}"></Label>
        <Label x:Name="TecnitiansLabel" Text="{Binding tecnitianName}"></Label>
        <Label x:Name="limitDateLabel" Text="{Binding limitDate}"></Label>
        <Button Text="cerrar" Clicked="onClickedClosePopUp"></Button>
    </VerticalStackLayout>    
</toolkit:Popup>
