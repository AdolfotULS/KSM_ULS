<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="KSM_ULS.Pages.LoginPage"
             Title="Login">
    <VerticalStackLayout Padding="24" Spacing="12">
        <Entry x:Name="UserEntry" Placeholder="Usuario" />
        <Entry x:Name="PassEntry" Placeholder="Contraseña" IsPassword="True" />
        <Button Text="Entrar" Clicked="OnLoginClicked" />
        <ActivityIndicator x:Name="Busy" IsVisible="False" IsRunning="False" />
        <Label x:Name="ErrorLabel" TextColor="Red" />
    </VerticalStackLayout>
</ContentPage>