<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="KSM_ULS.Pages.DashboardPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    Title="Krakenware"
    BackgroundColor="White">

    <ContentPage.Resources>
        <ResourceDictionary>
            <Color x:Key="PrimaryColor">#4A90E2</Color>
            <Color x:Key="SecondaryColor">#2C3E50</Color>
            <Color x:Key="AccentColor">#E74C3C</Color>
            <Color x:Key="BackgroundColor">#FFFFFF</Color>
        </ResourceDictionary>
    </ContentPage.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!--  encabezado superior  -->
        <Grid
            Grid.Row="0"
            Padding="16,10"
            BackgroundColor="{StaticResource SecondaryColor}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!--  boton menu  -->
            <Button
                x:Name="MenuButton"
                Grid.Column="0"
                BackgroundColor="Transparent"
                Clicked="OnMenuButtonClicked"
                FontSize="20"
                HeightRequest="40"
                Text="☰"
                TextColor="White"
                WidthRequest="40" />

            <!--  icono k  -->
            <Frame
                Grid.Column="1"
                Margin="10,0,0,0"
                Padding="0"
                BackgroundColor="{StaticResource PrimaryColor}"
                CornerRadius="20"
                HasShadow="False"
                HeightRequest="40"
                WidthRequest="40">
                <Label
                    FontAttributes="Bold"
                    FontSize="20"
                    HorizontalOptions="Center"
                    Text="K"
                    TextColor="White"
                    VerticalOptions="Center" />
            </Frame>

            <!--  titulo  -->
            <StackLayout
                Grid.Column="2"
                Margin="15,0,0,0"
                VerticalOptions="Center">
                <Label
                    FontAttributes="Bold"
                    FontSize="18"
                    Text="Krakenware"
                    TextColor="White" />
                <Label
                    FontSize="14"
                    Text="Inventario"
                    TextColor="LightGray" />
            </StackLayout>

            <!--  boton opciones  -->
            <Button
                Grid.Column="3"
                BackgroundColor="Transparent"
                Clicked="OnOptionsButtonClicked"
                FontSize="20"
                HeightRequest="40"
                Text="⋮"
                TextColor="White"
                WidthRequest="40" />
        </Grid>

        <!--  contenido principal  -->
        <ScrollView Grid.Row="1" BackgroundColor="{StaticResource BackgroundColor}">
            <StackLayout Padding="20" Spacing="20">
                <!--  host de la subvista  -->
                <ContentView x:Name="Host" />

            </StackLayout>
        </ScrollView>

        <!--  barra de navegacion inferior  -->
        <Grid
            Grid.Row="2"
            BackgroundColor="White"
            HeightRequest="60">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!--  dashboard  -->
            <Button
                x:Name="BottomNavDashboardButton"
                Grid.Column="0"
                BackgroundColor="#E3F2FD"
                Clicked="OnBottomNavDashboardClicked"
                FontSize="10"
                Text="📊 Dashboard"
                TextColor="{StaticResource PrimaryColor}" />

            <!--  tickets  -->
            <Button
                x:Name="BottomNavTicketsButton"
                Grid.Column="1"
                BackgroundColor="Transparent"
                Clicked="OnBottomNavTicketsClicked"
                FontSize="10"
                Text="🎫 Tickets"
                TextColor="Black" />

            <!--  clientes  -->
            <Button
                x:Name="BottomNavClientesButton"
                Grid.Column="2"
                BackgroundColor="Transparent"
                Clicked="OnBottomNavClientesClicked"
                FontSize="10"
                Text="👥 Clientes"
                TextColor="Black" />

            <!--  inventario (activo)  -->
            <Button
                x:Name="BottomNavInventarioButton"
                Grid.Column="3"
                BackgroundColor="Transparent"
                Clicked="OnBottomNavInventarioClicked"
                FontSize="10"
                Text="📦 Inventario"
                TextColor="Black" />

            <!--  reportes  -->
            <Button
                x:Name="BottomNavReportesButton"
                Grid.Column="4"
                BackgroundColor="Transparent"
                Clicked="OnBottomNavReportesClicked"
                FontSize="10"
                Text="📈 Reportes"
                TextColor="Gray" />
        </Grid>

        <!--  menu lateral overlay  -->
        <Grid
            x:Name="MenuOverlay"
            Grid.RowSpan="3"
            BackgroundColor="#80000000"
            IsVisible="False">

            <Frame
                Padding="0"
                BackgroundColor="White"
                CornerRadius="0"
                HasShadow="True"
                HorizontalOptions="Start"
                VerticalOptions="FillAndExpand"
                WidthRequest="280">

                <ScrollView>
                    <StackLayout Spacing="0">

                        <!--  encabezado del menu  -->
                        <Grid Padding="20,40,20,20" BackgroundColor="White">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="60" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="40" />
                            </Grid.ColumnDefinitions>

                            <!--  icono k  -->
                            <Frame
                                Grid.Row="0"
                                Grid.RowSpan="2"
                                Grid.Column="0"
                                Padding="0"
                                BackgroundColor="{StaticResource PrimaryColor}"
                                CornerRadius="30"
                                HasShadow="False"
                                HeightRequest="60"
                                WidthRequest="60">
                                <Label
                                    FontAttributes="Bold"
                                    FontSize="30"
                                    HorizontalOptions="Center"
                                    Text="K"
                                    TextColor="White"
                                    VerticalOptions="Center" />
                            </Frame>

                            <!--  titulo  -->
                            <Label
                                Grid.Row="0"
                                Grid.Column="1"
                                Margin="15,0,0,0"
                                FontAttributes="Bold"
                                FontSize="18"
                                Text="Krakenware"
                                TextColor="{StaticResource SecondaryColor}"
                                VerticalOptions="End" />

                            <!--  subtitulo  -->
                            <Label
                                Grid.Row="1"
                                Grid.Column="1"
                                Margin="15,0,0,0"
                                FontSize="14"
                                Text="Gestión Técnica"
                                TextColor="Gray"
                                VerticalOptions="Start" />

                            <!--  boton cerrar  -->
                            <Button
                                Grid.Row="0"
                                Grid.Column="2"
                                BackgroundColor="Transparent"
                                Clicked="OnCloseMenuClicked"
                                FontSize="16"
                                HeightRequest="30"
                                Text="✕"
                                TextColor="Gray"
                                WidthRequest="30" />
                        </Grid>

                        <!--  separador  -->
                        <BoxView BackgroundColor="LightGray" HeightRequest="1" />

                        <!--  modulos principales  -->
                        <Label
                            Margin="20,20,20,10"
                            FontAttributes="Bold"
                            FontSize="12"
                            Text="Módulos Principales"
                            TextColor="Gray" />

                        <!--  elementos del menu  -->
                        <Button
                            x:Name="MenuDashboardButton"
                            BackgroundColor="Transparent"
                            Clicked="OnMenuDashboardClicked"
                            HorizontalOptions="FillAndExpand"
                            Text="📊 Dashboard"
                            TextColor="{StaticResource PrimaryColor}" />

                        <Button
                            x:Name="MenuTicketsButton"
                            BackgroundColor="Transparent"
                            Clicked="OnMenuTicketsClicked"
                            HorizontalOptions="FillAndExpand"
                            Text="🎫 Tickets"
                            TextColor="{StaticResource SecondaryColor}" />

                        <Button
                            x:Name="MenuClientesButton"
                            BackgroundColor="Transparent"
                            Clicked="OnMenuClientesClicked"
                            HorizontalOptions="FillAndExpand"
                            Text="👥 Clientes"
                            TextColor="{StaticResource SecondaryColor}" />

                        <Button
                            x:Name="MenuInventarioButton"
                            BackgroundColor="#E3F2FD"
                            Clicked="OnMenuInventarioClicked"
                            FontAttributes="Bold"
                            HorizontalOptions="FillAndExpand"
                            Text="📦 Inventario"
                            TextColor="{StaticResource SecondaryColor}" />

                        <Button
                            x:Name="MenuGarantiasButton"
                            BackgroundColor="Transparent"
                            Clicked="OnMenuGarantiasClicked"
                            HorizontalOptions="FillAndExpand"
                            Text="🛡️ Garantías"
                            TextColor="{StaticResource SecondaryColor}" />

                        <Button
                            x:Name="MenuReportesButton"
                            BackgroundColor="Transparent"
                            Clicked="OnMenuReportesClicked"
                            HorizontalOptions="FillAndExpand"
                            Text="📈 Reportes"
                            TextColor="{StaticResource SecondaryColor}" />

                        <!--  espaciador  -->
                        <BoxView BackgroundColor="Transparent" HeightRequest="20" />

                        <!--  configuracion  -->
                        <Button
                            x:Name="MenuConfiguracionButton"
                            BackgroundColor="Transparent"
                            Clicked="OnMenuConfiguracionClicked"
                            HorizontalOptions="FillAndExpand"
                            Text="⚙️ Configuración"
                            TextColor="{StaticResource SecondaryColor}" />

                        <!--  cerrar sesion  -->
                        <Button
                            x:Name="MenuCerrarSesionButton"
                            BackgroundColor="Transparent"
                            Clicked="OnMenuCerrarSesionClicked"
                            HorizontalOptions="FillAndExpand"
                            Text="🚪 Cerrar sesión"
                            TextColor="{StaticResource AccentColor}" />

                    </StackLayout>
                </ScrollView>
            </Frame>
        </Grid>
    </Grid>
</ContentPage>