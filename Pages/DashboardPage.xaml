<?xml version="1.0" encoding="utf-8" ?>
<ContentPage 
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui" 
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml" 
    x:Class="KSM_ULS.Pages.DashboardPage" 
    Title="Krakenware"
    BackgroundColor="White">

    <ContentPage.Resources>
        <ResourceDictionary>
            <Color x:Key="PrimaryColor">#4A90E2</Color>
            <Color x:Key="SecondaryColor">#2C3E50</Color>
            <Color x:Key="AccentColor">#E74C3C</Color>
            <Color x:Key="BackgroundColor">#FFFFFF</Color>
        </ResourceDictionary>
    </ContentPage.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- encabezado superior -->
        <Grid Grid.Row="0" BackgroundColor="{StaticResource SecondaryColor}" Padding="16,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!-- boton menu -->
            <Button Grid.Column="0"
                    x:Name="MenuButton"
                    Text="☰"
                    FontSize="20"
                    BackgroundColor="Transparent"
                    TextColor="White"
                    WidthRequest="40"
                    HeightRequest="40"
                    Clicked="OnMenuButtonClicked" />

            <!-- icono k -->
            <Frame Grid.Column="1"
                   BackgroundColor="{StaticResource PrimaryColor}"
                   CornerRadius="20"
                   WidthRequest="40"
                   HeightRequest="40"
                   HasShadow="False"
                   Padding="0"
                   Margin="10,0,0,0">
                <Label Text="K" 
                       FontSize="20"
                       FontAttributes="Bold"
                       TextColor="White"
                       HorizontalOptions="Center"
                       VerticalOptions="Center" />
            </Frame>

            <!-- titulo -->
            <StackLayout Grid.Column="2" VerticalOptions="Center" Margin="15,0,0,0">
                <Label Text="Krakenware"
                       FontSize="18"
                       FontAttributes="Bold"
                       TextColor="White" />
                <Label Text="Inventario"
                       FontSize="14"
                       TextColor="LightGray" />
            </StackLayout>

            <!-- boton opciones -->
            <Button Grid.Column="3"
                    Text="⋮"
                    FontSize="20"
                    BackgroundColor="Transparent"
                    TextColor="White"
                    WidthRequest="40"
                    HeightRequest="40"
                    Clicked="OnOptionsButtonClicked" />
        </Grid>

        <!-- contenido principal -->
        <ScrollView Grid.Row="1" BackgroundColor="{StaticResource BackgroundColor}">
            <StackLayout Padding="20" Spacing="20">

                <!-- tarjeta de bienvenida -->
                <Frame BackgroundColor="White" 
                       HasShadow="True" 
                       CornerRadius="10" 
                       Padding="20">
                    <StackLayout>
                        <Label Text="Bienvenido al Dashboard"
                               FontSize="20"
                               FontAttributes="Bold"
                               TextColor="{StaticResource SecondaryColor}" />
                        <Label Text="Gestiona tu inventario de manera eficiente"
                               FontSize="14"
                               TextColor="Gray"
                               Margin="0,5,0,0" />
                    </StackLayout>
                </Frame>

                <!-- estadisticas -->
                <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto" ColumnSpacing="10" RowSpacing="10">

                    <Frame Grid.Row="0" Grid.Column="0"
                           BackgroundColor="{StaticResource PrimaryColor}"
                           HasShadow="True"
                           CornerRadius="10"
                           Padding="15">
                        <StackLayout>
                            <Label Text="📦" FontSize="24" HorizontalOptions="Center" />
                            <Label Text="1,234" 
                                   FontSize="24" 
                                   FontAttributes="Bold" 
                                   TextColor="White" 
                                   HorizontalOptions="Center" />
                            <Label Text="Productos" 
                                   FontSize="12" 
                                   TextColor="White" 
                                   HorizontalOptions="Center" />
                        </StackLayout>
                    </Frame>

                    <Frame Grid.Row="0" Grid.Column="1"
                           BackgroundColor="{StaticResource AccentColor}"
                           HasShadow="True"
                           CornerRadius="10"
                           Padding="15">
                        <StackLayout>
                            <Label Text="📋" FontSize="24" HorizontalOptions="Center" />
                            <Label Text="56" 
                                   FontSize="24" 
                                   FontAttributes="Bold" 
                                   TextColor="White" 
                                   HorizontalOptions="Center" />
                            <Label Text="Categorías" 
                                   FontSize="12" 
                                   TextColor="White" 
                                   HorizontalOptions="Center" />
                        </StackLayout>
                    </Frame>

                    <Frame Grid.Row="1" Grid.Column="0"
                           BackgroundColor="#FF9800"
                           HasShadow="True"
                           CornerRadius="10"
                           Padding="15">
                        <StackLayout>
                            <Label Text="⚠️" FontSize="24" HorizontalOptions="Center" />
                            <Label Text="23" 
                                   FontSize="24" 
                                   FontAttributes="Bold" 
                                   TextColor="White" 
                                   HorizontalOptions="Center" />
                            <Label Text="Stock Bajo" 
                                   FontSize="12" 
                                   TextColor="White" 
                                   HorizontalOptions="Center" />
                        </StackLayout>
                    </Frame>

                    <Frame Grid.Row="1" Grid.Column="1"
                           BackgroundColor="#4CAF50"
                           HasShadow="True"
                           CornerRadius="10"
                           Padding="15">
                        <StackLayout>
                            <Label Text="💰" FontSize="24" HorizontalOptions="Center" />
                            <Label Text="$89K" 
                                   FontSize="24" 
                                   FontAttributes="Bold" 
                                   TextColor="White" 
                                   HorizontalOptions="Center" />
                            <Label Text="Valor Total" 
                                   FontSize="12" 
                                   TextColor="White" 
                                   HorizontalOptions="Center" />
                        </StackLayout>
                    </Frame>
                </Grid>

                <!-- acciones rapidas -->
                <Frame BackgroundColor="White" 
                       HasShadow="True" 
                       CornerRadius="10" 
                       Padding="20">
                    <StackLayout>
                        <Label Text="Acciones Rápidas"
                               FontSize="18"
                               FontAttributes="Bold"
                               TextColor="{StaticResource SecondaryColor}"
                               Margin="0,0,0,15" />

                        <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                            <Button Grid.Column="0"
                                    Text="Agregar Producto"
                                    BackgroundColor="{StaticResource PrimaryColor}"
                                    TextColor="White"
                                    CornerRadius="8"
                                    Clicked="OnAgregarProductoClicked" />

                            <Button Grid.Column="1"
                                    Text="Ver Reportes"
                                    BackgroundColor="{StaticResource SecondaryColor}"
                                    TextColor="White"
                                    CornerRadius="8"
                                    Clicked="OnVerReportesClicked" />
                        </Grid>
                    </StackLayout>
                </Frame>

                <!-- host de la subvista -->
                <ContentView x:Name="Host" />

            </StackLayout>
        </ScrollView>

        <!-- barra de navegacion inferior -->
        <Grid Grid.Row="2" 
              BackgroundColor="White" 
              HeightRequest="60">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- dashboard -->
            <Button Grid.Column="0"
                    Text="📊 Dashboard"
                    FontSize="10"
                    BackgroundColor="Transparent"
                    TextColor="Gray"
                    Clicked="OnBottomNavDashboardClicked" />

            <!-- tickets -->
            <Button Grid.Column="1"
                    Text="🎫 Tickets"
                    FontSize="10"
                    BackgroundColor="Transparent"
                    TextColor="Gray"
                    Clicked="OnBottomNavTicketsClicked" />

            <!-- clientes -->
            <Button Grid.Column="2"
                    Text="👥 Clientes"
                    FontSize="10"
                    BackgroundColor="Transparent"
                    TextColor="Gray"
                    Clicked="OnBottomNavClientesClicked" />

            <!-- inventario (activo) -->
            <Button Grid.Column="3"
                    Text="📦 Inventario"
                    FontSize="10"
                    BackgroundColor="#E3F2FD"
                    TextColor="{StaticResource PrimaryColor}"
                    FontAttributes="Bold"
                    Clicked="OnBottomNavInventarioClicked" />

            <!-- reportes -->
            <Button Grid.Column="4"
                    Text="📈 Reportes"
                    FontSize="10"
                    BackgroundColor="Transparent"
                    TextColor="Gray"
                    Clicked="OnBottomNavReportesClicked" />
        </Grid>

        <!-- menu lateral overlay -->
        <Grid x:Name="MenuOverlay" 
              Grid.RowSpan="3"
              BackgroundColor="#80000000"
              IsVisible="False">

            <Frame WidthRequest="280"
                   BackgroundColor="White"
                   HorizontalOptions="Start"
                   VerticalOptions="FillAndExpand"
                   HasShadow="True"
                   CornerRadius="0"
                   Padding="0">

                <ScrollView>
                    <StackLayout Spacing="0">

                        <!-- encabezado del menu -->
                        <Grid BackgroundColor="White" Padding="20,40,20,20">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="60" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="40" />
                            </Grid.ColumnDefinitions>

                            <!-- icono k -->
                            <Frame Grid.Row="0" Grid.Column="0" Grid.RowSpan="2"
                                   BackgroundColor="{StaticResource PrimaryColor}"
                                   CornerRadius="30"
                                   WidthRequest="60"
                                   HeightRequest="60"
                                   HasShadow="False"
                                   Padding="0">
                                <Label Text="K" 
                                       FontSize="30"
                                       FontAttributes="Bold"
                                       TextColor="White"
                                       HorizontalOptions="Center"
                                       VerticalOptions="Center" />
                            </Frame>

                            <!-- titulo -->
                            <Label Grid.Row="0" Grid.Column="1"
                                   Text="Krakenware"
                                   FontSize="18"
                                   FontAttributes="Bold"
                                   TextColor="{StaticResource SecondaryColor}"
                                   VerticalOptions="End"
                                   Margin="15,0,0,0" />

                            <!-- subtitulo -->
                            <Label Grid.Row="1" Grid.Column="1"
                                   Text="Gestión Técnica"
                                   FontSize="14"
                                   TextColor="Gray"
                                   VerticalOptions="Start"
                                   Margin="15,0,0,0" />

                            <!-- boton cerrar -->
                            <Button Grid.Row="0" Grid.Column="2"
                                    Text="✕"
                                    FontSize="16"
                                    BackgroundColor="Transparent"
                                    TextColor="Gray"
                                    WidthRequest="30"
                                    HeightRequest="30"
                                    Clicked="OnCloseMenuClicked" />
                        </Grid>

                        <!-- separador -->
                        <BoxView BackgroundColor="LightGray" HeightRequest="1" />

                        <!-- modulos principales -->
                        <Label Text="Módulos Principales"
                               FontSize="12"
                               FontAttributes="Bold"
                               TextColor="Gray"
                               Margin="20,20,20,10" />

                        <!-- elementos del menu -->
                        <Button Text="📊 Dashboard"
                                BackgroundColor="Transparent"
                                TextColor="{StaticResource SecondaryColor}"
                                HorizontalOptions="FillAndExpand"
                                Clicked="OnMenuDashboardClicked" />

                        <Button Text="🎫 Tickets"
                                BackgroundColor="Transparent"
                                TextColor="{StaticResource SecondaryColor}"
                                HorizontalOptions="FillAndExpand"
                                Clicked="OnMenuTicketsClicked" />

                        <Button Text="👥 Clientes"
                                BackgroundColor="Transparent"
                                TextColor="{StaticResource SecondaryColor}"
                                HorizontalOptions="FillAndExpand"
                                Clicked="OnMenuClientesClicked" />

                        <Button Text="📦 Inventario"
                                BackgroundColor="#E3F2FD"
                                TextColor="{StaticResource PrimaryColor}"
                                FontAttributes="Bold"
                                HorizontalOptions="FillAndExpand"
                                Clicked="OnMenuInventarioClicked" />

                        <Button Text="🛡️ Garantías"
                                BackgroundColor="Transparent"
                                TextColor="{StaticResource SecondaryColor}"
                                HorizontalOptions="FillAndExpand"
                                Clicked="OnMenuGarantiasClicked" />

                        <Button Text="📈 Reportes"
                                BackgroundColor="Transparent"
                                TextColor="{StaticResource SecondaryColor}"
                                HorizontalOptions="FillAndExpand"
                                Clicked="OnMenuReportesClicked" />

                        <!-- espaciador -->
                        <BoxView HeightRequest="20" BackgroundColor="Transparent" />

                        <!-- configuracion -->
                        <Button Text="⚙️ Configuración"
                                BackgroundColor="Transparent"
                                TextColor="{StaticResource SecondaryColor}"
                                HorizontalOptions="FillAndExpand"
                                Clicked="OnMenuConfiguracionClicked" />

                        <!-- cerrar sesion -->
                        <Button Text="🚪 Cerrar sesión"
                                BackgroundColor="Transparent"
                                TextColor="{StaticResource AccentColor}"
                                HorizontalOptions="FillAndExpand"
                                Clicked="OnMenuCerrarSesionClicked" />

                    </StackLayout>
                </ScrollView>
            </Frame>
        </Grid>
    </Grid>
</ContentPage>